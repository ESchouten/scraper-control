<?xml version="1.0" encoding="utf-8"?>
<!-- One route: a big letter, the route's name and its last run, as in the app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/route_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical">
        <TextView
            android:id="@+id/letter"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_button_big"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Route A"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_tap_to_start"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:src="@drawable/widget_play"
        android:importantForAccessibility="no" />
</FrameLayout>
