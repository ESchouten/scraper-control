<?xml version="1.0" encoding="utf-8"?>
<!-- Placed 4x2; can be made one row high (minResizeHeight), then a compact layout (WidgetViews).
     updatePeriodMillis: every 30 min (the least Android allows) the widget is drawn again,
     so a next-run time that has passed is dropped (WidgetBridge.bar). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_routes"
    android:previewLayout="@layout/widget_routes"
    android:configure="nl.eschouten.scraper.WidgetConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/widget_routes_description" />
